# ECDAT Environment — copy to .env and fill in production values
# For local dev, defaults below work with Docker Compose

# Database
POSTGRES_USER=ecdat
POSTGRES_PASSWORD=ecdat_secret
POSTGRES_DB=ecdat

# The API uses asyncpg for async; sync URL used for Alembic
DATABASE_URL=postgresql+asyncpg://ecdat:ecdat_secret@localhost:5432/ecdat
SYNC_DATABASE_URL=postgresql://ecdat:ecdat_secret@localhost:5432/ecdat

# Redis / RQ
REDIS_URL=redis://localhost:6379/0

# Upload limits and storage
ECDAT_UPLOAD_DIR=./uploads
ECDAT_MAX_UPLOAD_BYTES=268435456      # 256 MB hard limit per artifact
ECDAT_MAX_ARCHIVE_MEMBERS=10000       # zip bomb protection
ECDAT_MAX_DECOMPRESSED_BYTES=1073741824  # 1 GB decompressed limit

# Risk engine seed (reproducible Monte Carlo)
ECDAT_RISK_SEED=20260930

# Set to 1 to disable all outbound network calls in demo
ECDAT_OFFLINE=1

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
